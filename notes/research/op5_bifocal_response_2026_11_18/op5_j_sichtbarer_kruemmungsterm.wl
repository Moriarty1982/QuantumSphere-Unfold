Clear[t,x,y,z,rad,amp,m,p,h,c0,c1,c2,c3];
coords={t,x,y,z};
eta=DiagonalMatrix[{-1,1,1,1}];
n={1,0,0,1};
e={0,1,0,0};
ampF={{0,c0,c1,c2},{-c0,0,c3,0},{-c1,-c3,0,0},{-c2,0,0,0}};
pvec={t,x,y,z};
divCheck=Expand[(pvec.ampF.pvec) (ampF.pvec)];
profile=-amp p[z] Exp[-(x^2+y^2)/rad^2];
f=Laplacian[profile,{x,y}]/m^2;
mixed=FullSimplify[D[f,{x,2}]/.{x->0,y->0},Assumptions->m>0&&rad>0];
gauge=Table[D[h[t,x,y,z],coords[[i]],coords[[j]]],{i,4},{j,4}];
curv[mat_]:=Module[{dn,de},dn[k_]:=D[k,t]+D[k,z];de[k_]:=D[k,x];
 Simplify[dn[de[n.mat.e]]-(de[de[n.mat.n]]+dn[dn[e.mat.e]])/2]];
Print["Visible improvement divergence: ",InputForm[divCheck]];
Print["Longitudinal curvature residual: ",InputForm[curv[gauge]]];
Print["Conformal tidal term: ",InputForm[curv[eta h[t,x,y,z]]]];
Print["Axial transverse Hessian: ",InputForm[mixed]];
Print["Axial tidal trace per polarization: ",InputForm[-mixed/2]];
