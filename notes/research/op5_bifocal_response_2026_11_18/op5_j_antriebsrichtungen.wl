Clear[x,y,z,t,kx,ky,kz,rho,mu,lam,a,h];
xyz={x,y,z};
p=DiagonalMatrix[{1,1,0}];
g=h[t,x,y,z];
u=-p.Grad[g,xyz]/rho;
strain=Table[(D[u[[i]],xyz[[j]]]+D[u[[j]],xyz[[i]]])/2,{i,3},{j,3}];
compliance[stress_]:=(stress-lam Tr[stress] IdentityMatrix[3]/(2 mu+3 lam))/(2 mu);
hooke[e_]:=2 mu e+lam Tr[e] IdentityMatrix[3];
eigen=strain+compliance[p D[g,{t,2}]];
zz=FullSimplify[eigen[[3,3]]];
polys={kx^2,ky^2,kx ky,kx kz/2,ky kz/2};
powers={{2,0,0},{0,2,0},{1,1,0},{1,0,1},{0,1,1}};
coefficient=Table[Coefficient[Coefficient[Coefficient[q,kx,power[[1]]],ky,power[[2]]],kz,power[[3]]],{q,polys},{power,powers}];
gauss=Exp[-(x^2+y^2)/a^2];
curvature=FullSimplify[Laplacian[Laplacian[gauss,{x,y}],{x,y}]/.{x->0,y->0},Assumptions->a>0];
Print["Plateau polynomial rank: ",InputForm[MatrixRank[coefficient]]];
Print["Axial eigenstrain: ",InputForm[zz]];
Print["Constitutive residual: ",InputForm[FullSimplify[hooke[strain-eigen]+p D[g,{t,2}]]]];
Print["Transverse bi-Laplacian of axial core: ",InputForm[curvature]];
