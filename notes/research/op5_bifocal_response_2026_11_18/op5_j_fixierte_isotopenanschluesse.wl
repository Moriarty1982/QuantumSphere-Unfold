ClearAll["Global`*"];
uH = 1 - 4/(1 + 1836152673426/10^9);
uD = 1 - 7/(1 + 3670482967655/10^9);
coupling = rho;
portMap = {{-coupling u, 1}, {-coupling v, 1}};
columnSineSquared = rho^2 (u-v)^2/((1+rho^2 u^2) (1+rho^2 v^2));
optimalRho = 1/Sqrt[u v];
sineOptimal = FullSimplify[columnSineSquared /. rho -> optimalRho, u > 0 && v > 0];
optimalCondition = (Sqrt[u] + Sqrt[v])^2/Abs[u-v];
normalizedPorts = Normalize /@ N[portMap /. {rho -> 1, u -> uH, v -> uD}, 30];
singular = SingularValueList[normalizedPorts, Tolerance -> 0];
Print["symbolic determinant = ", InputForm[Factor[Det[portMap]]]];
Print["stationary sine residual = ", FullSimplify[D[columnSineSquared, rho] /. rho -> optimalRho, u > 0 && v > 0]];
Print["optimal sine squared = ", InputForm[Factor[sineOptimal]]];
Print["H recoil coefficient = ", InputForm[N[1-uH, 10]]];
Print["D recoil coefficient = ", InputForm[N[1-uD, 10]]];
Print["absolute recoil splitting = ", InputForm[N[Abs[uD-uH], 10]]];
Print["balanced normalized singular values = ", InputForm[N[singular, 10]]];
Print["balanced normalized condition = ", InputForm[N[First[singular]/Last[singular], 10]]];
Print["best diagonal-kinetic coupling ratio = ", InputForm[N[optimalRho /. {u -> uH, v -> uD}, 10]]];
Print["best diagonal-kinetic normalized condition = ", InputForm[N[optimalCondition /. {u -> uH, v -> uD}, 10]]];
