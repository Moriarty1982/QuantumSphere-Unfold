Clear[d,m,k,x,y,a,u,r,t,s,amp,mom];
source=d (1+d/m^2)/m^2;
massless=Together[source/d-(1+d/m^2)/m^2];
massive=Together[source/(1+d/m^2)-d/m^2];
g[radius_]:=(1-(x^2+y^2)/radius^2)^6;
transverse=FullSimplify[Laplacian[g[a]-g[2 a]/4,{x,y}]/.{x->0,y->0},Assumptions->a>0];
axial=Integrate[(1-u^2)^6,{u,-1,1}];
angular=Integrate[2 Pi r ((1-r^2/a^2)^6),{r,0,a},Assumptions->a>0];
planeMass=FullSimplify[angular-(angular/.a->2 a)/4,Assumptions->a>0];
profile=(1-u^2)^6;
edges=Table[D[profile,{u,k}]/.u->1,{k,0,5}];
moment=Expand[D[-mom s[t],{t,2}]/m^2+D[-mom s[t],{t,4}]/m^4];
Print["Massless inverse residual: ",InputForm[massless]];
Print["Massive inverse residual: ",InputForm[massive]];
Print["Transverse integral: ",InputForm[planeMass]];
Print["Axial integral on unit half-length: ",InputForm[axial]];
Print["Transverse Laplacian on axis: ",InputForm[transverse]];
Print["Static axial contrast factor (times A ell / (a^2 m^2)): ",InputForm[FullSimplify[-transverse axial a^2]]];
Print["Boundary derivatives (orders 0 to 5): ",InputForm[edges]];
Print["Transverse density moment: ",InputForm[moment]];
