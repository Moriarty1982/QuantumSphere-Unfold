Clear[w,kx,ky,kz,x,a,mm,kk,g0,gm,z0,om,sg,sm];
p=DiagonalMatrix[{1,1,0}];
k={kx,ky,kz};
pv=p.k;
eta=DiagonalMatrix[{-1,1,1,1}];
tensor=ArrayFlatten[{{{{-pv.pv}},{-w pv}},{Transpose[{-w pv}],-w^2 p}}];
trace=Tr[eta.tensor];
square=Tr[eta.tensor.eta.tensor];
replace={kx^2+ky^2->a,w^2->x};
num0=FullSimplify[square-trace^2/2-(kx^2+ky^2)^2/2];
numm=FullSimplify[square-trace^2/3-2 ((kx^2+ky^2)^2-w^2 (kx^2+ky^2)+w^4)/3];
fp=2 (x^2-a x+a^2)/3;
split=Together[fp/(mm-x)-2 (-x+a-mm+(mm^2-a mm+a^2)/(mm-x))/3];
kernel=z0 (x-om)+g0^2 a^2/(2 (kk-x))+gm^2 fp/(mm-x);
mat={{(z0-2 gm^2/3)x-z0 om+2 gm^2(a-mm)/3,sg,sm},{sg,x-kk,0},{sm,0,x-mm}};
rescale={sg->Sqrt[g0^2 a^2/2],sm->Sqrt[2 gm^2 (mm^2-a mm+a^2)/3]};
repack=Together[(Det[mat]/((x-kk)(x-mm)) /. rescale)-kernel];
Print["Conserved source residual: ",InputForm[Simplify[Join[{-w},k].tensor]]];
Print["Massless numerator residual: ",InputForm[num0]];
Print["Massive numerator residual: ",InputForm[numm]];
Print["Massive pole division residual: ",InputForm[split]];
Print["Oscillator representation residual: ",InputForm[repack]];
Print["Static scalar Schur complement: ",InputForm[kernel/.x->0]];
