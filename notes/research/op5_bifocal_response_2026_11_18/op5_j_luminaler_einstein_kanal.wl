Clear[w,kx,ky,kz,dd,r,x,a,z0,om,g0,gm,nm,alpha,rad,xx,yy];
eta=DiagonalMatrix[{-1,1,1,1}];
p={w,kx,ky,kz};
d=p.eta.p;
s=Outer[Times,p,p]-eta d;
trace=Tr[eta.s];
norm=Tr[eta.s.eta.s];
ker=z0 (x-om)-3 g0^2 dd/2+gm^2 nm/r;
drive=(z0 (om-x)+3 g0^2 dd/2)r-gm^2 nm;
bs=111/200-alpha/50;
as=41/40;
mixSq=(1/4-alpha/2+alpha^2)/50;
lower=Expand[bs-2 mixSq];
upper=Expand[as-bs-2 mixSq];
lap=FullSimplify[Laplacian[Exp[-(xx^2+yy^2)/rad^2],{xx,yy}]/.{xx->0,yy->0},Assumptions->rad>0];
Print["Conformal source divergence: ",InputForm[Simplify[(eta.p).s]]];
Print["Einstein contact residual: ",InputForm[FullSimplify[norm-trace^2/2+3 d^2/2]]];
Print["Same-source Fierz-Pauli contraction: ",InputForm[FullSimplify[norm-trace^2/3]]];
Print["Trace-reversed metric residual: ",InputForm[FullSimplify[s-eta trace/2-Outer[Times,p,p]-eta d/2]]];
Print["Compact drive residual: ",InputForm[Together[ker r+drive]]];
Print["Characteristic lower endpoint margins: ",InputForm[{lower/.alpha->0,lower/.alpha->1}]];
Print["Characteristic upper endpoint margins: ",InputForm[{upper/.alpha->0,upper/.alpha->1}]];
Print["Margin curvatures: ",InputForm[{D[lower,{alpha,2}],D[upper,{alpha,2}]}]];
Print["Axial transverse Laplacian: ",InputForm[lap]];
