(* k364b (H169): unabhaengige Gegenprobe. Inneres j als Symbol mit j^2 = -1 (Reduktion modulo j^2 + 1), aeusseres I. *)
red[e_] := PolynomialRemainder[Expand[e], j^2 + 1, j];
sig[e_] := e /. j -> -j;
P = (1 + I j)/2; Pb = (1 - I j)/2;
Print["a1 P^2-P, Pb^2-Pb, P Pb: ", red /@ {P^2 - P, Pb^2 - Pb, P Pb}];
Print["a2 1 + c j - [(1 - I c) P + (1 + I c) Pb]: ", red[1 + c j - ((1 - I c) P + (1 + I c) Pb)]];
Print["a3 (1 + c j)/2 idempotent fuer c: ", Solve[Thread[CoefficientList[red[((1 + c j)/2)^2 - (1 + c j)/2], j] == 0], c]];
Print["a4 ((1+j)/2)^2 - j/2: ", red[((1 + j)/2)^2 - j/2]];
w[k_] := (-a + j) x[k];
Z = {{0, w[1], sig[w[3]]}, {sig[w[1]], 0, w[2]}, {w[3], sig[w[2]], 0}};
mp[A_, B_] := Map[red, A . B, {2}];
Z2 = mp[Z, Z]; Z3 = mp[Z2, Z]; Z4 = mp[Z2, Z2];
n2 = x[1]^2 + x[2]^2 + x[3]^2;
Print["b1 Tr Z^2 - 2(1+a^2)|x|^2: ", Simplify[Tr[Z2] - 2 (1 + a^2) n2]];
Print["b2 Tr Z^4 - 2(1+a^2)^2|x|^4: ", Simplify[Tr[Z4] - 2 (1 + a^2)^2 n2^2]];
Print["b3 Tr Z^3/3 - 2(3a - a^3) x1 x2 x3: ", Simplify[Tr[Z3]/3 - 2 (3 a - a^3) x[1] x[2] x[3]]];
Print["b4 bei a = I: ", Simplify[{Tr[Z2], Tr[Z4], Tr[Z3]/3} /. a -> I], "; bei a = -I: ", Simplify[{Tr[Z2], Tr[Z4], Tr[Z3]/3} /. a -> -I]];
Print["b5 (-I + j) - 2 j P: ", red[(-I + j) - 2 j P]];
z = r (Cos[d] + j Sin[d]);
Print["c1 P z - r Exp[-I d] P, Pb z - r Exp[I d] Pb: ", FullSimplify[CoefficientList[red[P z - r (Cos[d] - I Sin[d]) P], j]], FullSimplify[CoefficientList[red[Pb z - r (Cos[d] + I Sin[d]) Pb], j]]];
Print["c2 sig[P] - Pb: ", Simplify[sig[P] - Pb], "; j sig[s + j v] - (v + j s): ", red[j sig[s + j v] - (v + j s)]];
Print["c3 (1 + I c)/(1 - I c) bei c = 1, 0: ", {(1 + I c)/(1 - I c) /. c -> 1, (1 + I c)/(1 - I c) /. c -> 0}];
f = -Cos[2 (d - ArcTan[c])];
Print["d1 gerader, ungerader Teil: ", FullSimplify[TrigExpand[(f + (f /. d -> -d))/2], c \[Element] Reals], "; ", FullSimplify[TrigExpand[(f - (f /. d -> -d))/2], c \[Element] Reals]];
Print["d2 rein ungerade fuer c: ", Solve[c^2 - 1 == 0, c], "; rein gerade fuer c: ", Solve[2 c == 0, c]];
solv = First[Solve[{s == sp - c vp, v == vp + c sp}, {sp, vp}]];
T1 = Simplify[(1 + c^2) vp^2 /. solv];
Print["d3 (1+c^2) v'^2 = ", Factor[T1], "; c = 1 minus [(s^2+v^2)/2 - s v]: ", Simplify[(T1 /. c -> 1) - ((s^2 + v^2)/2 - s v)]];
Print["d4 invariant unter s <-> v fuer c: ", Solve[Thread[Flatten[CoefficientList[Numerator[Together[T1 - (T1 /. {s -> v, v -> s})]], {s, v}]] == 0], c]];
ds = 0.2222220470731`20; xx = Pi/12 - ds;
Print["e1 x, tan 2x: ", N[xx, 12], " ", N[Tan[2 xx], 12]];
Print["e2 geladen, X/Y = Cot[2 d]: ", Table[N[Cot[2 (sg ds + 2 Pi k/3)], 10], {sg, {1, -1}}, {k, 0, 2}]];
Print["e3 neutral, Y/X = Tan[2 d]: ", Table[N[Tan[2 (sg (Pi/6 - xx) + 2 Pi k/3)], 10], {sg, {1, -1}}, {k, 0, 2}]];
