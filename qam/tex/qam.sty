% qam.sty -- QAM bookkeeping checks at compile time
%
% Declares the claims of a document with a status, a frame and the inputs they rest on,
% and makes the TeX compiler stop with an error when
%   * a derived claim gets a higher status than its weakest premise   (promotion),
%   * claims of different frames are combined or compared without a declared map (frame mixing),
%   * a claim that rests on a put-in value is cited as independent of inputs (input read as result),
%   * a key is used before it is declared, or declared twice (append-only record).
%
% Independent of any particular project.  Rules match the Lean module QSFormal.Provenance.
%
% Generated notation: \qam{key} typesets a claim in QAM notation, \qamledger a table of all claims;
% with the option export every claim is also written as a QAM line to \jobname.qam.
%
% Usage:  \usepackage{qam}            errors (default)
%         \usepackage[mode=warning]{qam}   warnings only
%
% Status order: open < reading < conditional < computed < proved
%
% License: CC BY 4.0
\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesExplPackage{qam}{2026-11-04}{0.2}{QAM bookkeeping checks}

% ---------------------------------------------------------------- options
\tl_new:N \g__qam_mode_tl
\bool_new:N \g__qam_export_bool
\tl_gset:Nn \g__qam_mode_tl { error }
\keys_define:nn { qam }
  {
    mode .choices:nn = { error , warning }
      { \tl_gset:Nx \g__qam_mode_tl { \l_keys_choice_tl } } ,
    export .bool_gset:N = \g__qam_export_bool ,
    export .default:n = true ,
  }
\ProcessKeyOptions [ qam ]

% ---------------------------------------------------------------- storage
\prop_new:N \g__qam_status_prop   % key -> rank
\prop_new:N \g__qam_frame_prop    % key -> frame
\prop_new:N \g__qam_inputs_prop   % key -> comma list of inputs
\prop_new:N \g__qam_frames_prop   % declared frames
\prop_new:N \g__qam_src_prop      % map -> source frame
\prop_new:N \g__qam_tgt_prop      % map -> target frame
\prop_new:N \g__qam_sym_prop      % key -> math symbol
\prop_new:N \g__qam_kind_prop     % key -> input | claim | derive | convert
\prop_new:N \g__qam_prem_prop     % key -> premises (derive) or map,premise (convert)
\prop_new:N \g__qam_msym_prop     % map -> math symbol
\seq_new:N  \g__qam_order_seq     % keys in declaration order
\prop_new:N \g__qam_hash_prop     % key -> MD5 hash of the canonical form (content + source hashes)
\prop_new:N \g__qam_srcs_prop     % key -> comma list of source hashes
\prop_new:N \g__qam_stmt_prop     % key -> statement (thesis only), as string
\tl_new:N   \l__qam_stmt_tl
\tl_new:N   \l__qam_canon_tl
\clist_new:N \l__qam_srcs_clist
\clist_new:N \l__qam_prem_clist
\tl_new:N   \l__qam_kind_tl
\tl_new:N   \l__qam_sym_tl
\tl_new:N   \l__qam_prem_tl
\iow_new:N  \g__qam_iow

\int_new:N  \l__qam_min_int
\int_new:N  \l__qam_rank_int
\tl_new:N   \l__qam_weak_tl
\tl_new:N   \l__qam_frame_tl
\tl_new:N   \l__qam_first_tl
\tl_new:N   \l__qam_tmp_tl
\clist_new:N \l__qam_inputs_clist
\clist_new:N \l__qam_tmp_clist

\cs_new:Npn \__qam_rank:n #1
  {
    \str_case:nnF {#1}
      { { open } { 0 } { reading } { 1 } { conditional } { 2 } { computed } { 3 } { proved } { 4 } }
      { -1 }
  }
\cs_new:Npn \__qam_name:n #1
  { \int_case:nnF {#1} { { 0 } { open } { 1 } { reading } { 2 } { conditional } { 3 } { computed } { 4 } { proved } } { ? } }

% ---------------------------------------------------------------- messages
\msg_new:nnnn { qam } { promotion }
  { Promotion:~`#1'~is~declared~`#2',~but~its~weakest~premise~`#3'~is~only~`#4'. }
  { A~derived~claim~can~have~at~most~the~status~of~its~weakest~premise. }
\msg_new:nnnn { qam } { frame-mix-combined }
  { Frame~mixing:~`#1'~(frame~#2)~and~`#3'~(frame~#4)~are~combined~without~a~declared~map. }
  { Declare~a~map~with~\token_to_str:N \qammap\ and~use~\token_to_str:N \qamconvert. }
\msg_new:nnnn { qam } { frame-mix-compared }
  { Frame~mixing:~`#1'~(frame~#2)~and~`#3'~(frame~#4)~are~compared~without~a~declared~map. }
  { Declare~a~map~with~\token_to_str:N \qammap\ and~use~\token_to_str:N \qamconvert. }
\msg_new:nnnn { qam } { not-independent }
  { `#1'~is~cited~as~independent~of~inputs,~but~it~rests~on:~#2. }
  { A~value~that~was~put~in~cannot~be~cited~as~a~result. }
\msg_new:nnn { qam } { undeclared }  { #2~`#1'~is~used~but~not~declared. }
\msg_new:nnn { qam } { duplicate }   { Claim~`#1'~is~declared~twice~(the~record~is~append-only). }
\msg_new:nnn { qam } { bad-status }  { Unknown~status~`#1'~(use~open,~reading,~conditional,~computed,~proved). }
\msg_new:nnn { qam } { map-source }  { Map~#1~goes~from~frame~#2,~but~`#3'~lives~in~frame~#4. }
\msg_new:nnn { qam } { semicolon }   { The~statement~of~thesis~`#1'~must~not~contain~a~semicolon. }
\msg_new:nnn { qam } { no-premises } { Claim~`#1'~is~derived~from~no~premises;~use~\token_to_str:N \qamclaim. }

\cs_new_protected:Npn \__qam_problem:nnnnn #1#2#3#4#5
  {
    \str_if_eq:VnTF \g__qam_mode_tl { error }
      { \msg_error:nnxxxx   { qam } {#1} {#2} {#3} {#4} {#5} }
      { \msg_warning:nnxxxx { qam } {#1} {#2} {#3} {#4} {#5} }
  }
\cs_new_protected:Npn \__qam_problem:nnn #1#2#3
  { \__qam_problem:nnnnn {#1} {#2} {#3} { } { } }

% ---------------------------------------------------------------- checks
\cs_new_protected:Npn \__qam_check_status:n #1
  { \int_compare:nNnT { \__qam_rank:n {#1} } < { 0 } { \__qam_problem:nnn { bad-status } {#1} { } } }
\cs_new_protected:Npn \__qam_check_frame:n #1
  { \prop_if_in:NnF \g__qam_frames_prop {#1} { \__qam_problem:nnn { undeclared } {#1} { Frame } } }
\prg_new_protected_conditional:Npnn \__qam_if_claim:n #1 { T , F , TF }
  {
    \prop_if_in:NnTF \g__qam_status_prop {#1}
      { \prg_return_true: }
      { \__qam_problem:nnn { undeclared } {#1} { Claim } \prg_return_false: }
  }
\cs_new_protected:Npn \__qam_new:nnnn #1#2#3#4
  {
    \prop_if_in:NnTF \g__qam_status_prop {#1}
      { \__qam_problem:nnn { duplicate } {#1} { } }
      {
        \prop_gput:Nnx \g__qam_status_prop {#1} {#3}
        \prop_gput:Nnx \g__qam_frame_prop  {#1} {#2}
        \prop_gput:Nnn \g__qam_inputs_prop {#1} {#4}
        \prop_gput:NnV \g__qam_sym_prop  {#1} \l__qam_sym_tl
        \prop_gput:NnV \g__qam_kind_prop {#1} \l__qam_kind_tl
        \prop_gput:NnV \g__qam_prem_prop {#1} \l__qam_prem_tl
        \__qam_hash:nnnn {#1} {#2} {#3} {#4}
        \seq_gput_right:Nn \g__qam_order_seq {#1}
        \bool_if:NT \g__qam_export_bool { \__qam_export:n {#1} }
      }
  }
\cs_generate_variant:Nn \__qam_new:nnnn { nVnV , nnnV }

% Hash of a claim: MD5 of the canonical line
%   kind;key;frame;status;inputs;sources;statement
% where sources are the hashes of the premises.  A change anywhere upstream changes every hash below it.
\cs_new_protected:Npn \__qam_hash:nnnn #1#2#3#4
  {
    \clist_set:NV \l__qam_prem_clist \l__qam_prem_tl
    \clist_clear:N \l__qam_srcs_clist
    \str_case:VnF \l__qam_kind_tl
      {
        { derive }
          { \clist_map_inline:Nn \l__qam_prem_clist
              { \clist_put_right:Nx \l__qam_srcs_clist { \prop_item:Nn \g__qam_hash_prop {##1} } } }
        { convert }
          { \clist_put_right:Nx \l__qam_srcs_clist
              { \exp_args:NNe \prop_item:Nn \g__qam_hash_prop { \clist_item:Nn \l__qam_prem_clist { 2 } } } }
      }
      { }
    \tl_set:Nx \l__qam_canon_tl
      {
        \str_if_eq:VnTF \l__qam_kind_tl { convert }
          { convert( \clist_item:Nn \l__qam_prem_clist { 1 } ) } { \tl_use:N \l__qam_kind_tl }
        ; #1 ; #2 ; \__qam_name:n {#3} ; \clist_use:nn {#4} { , } ;
        \clist_use:Nn \l__qam_srcs_clist { , } ; \tl_use:N \l__qam_stmt_tl
      }
    \prop_gput:Nnx \g__qam_hash_prop {#1} { \exp_args:NV \str_mdfive_hash:n \l__qam_canon_tl }
    \prop_gput:NnV \g__qam_srcs_prop {#1} \l__qam_srcs_clist
    \prop_gput:NnV \g__qam_stmt_prop {#1} \l__qam_stmt_tl
  }
\cs_generate_variant:Nn \str_case:nnF { V }

% ---------------------------------------------------------------- user commands
% \qamframe{M}            declare a frame
\NewDocumentCommand \qamframe { m } { \prop_gput:Nnn \g__qam_frames_prop {#1} { } }

% \qammap{G}{M}{T}        declare a comparison map G from frame M to frame T
\cs_new_protected:Npn \__qam_cmd_map:nnn #1#2#3
  {
    \__qam_check_frame:n {#2} \__qam_check_frame:n {#3}
    \prop_gput:Nnn \g__qam_src_prop {#1} {#2}
    \prop_gput:Nnn \g__qam_tgt_prop {#1} {#3}
    \bool_if:NT \g__qam_export_bool { \__qam_write:x { map ~ #1 ~ : ~ #2 ~ -> ~ #3 } }
  }

% \qaminput{key}{frame}{status}   a value put in by hand; it is its own input
\cs_new_protected:Npn \__qam_cmd_input:nnn #1#2#3
  {
    \__qam_check_frame:n {#2} \__qam_check_status:n {#3}
    \__qam_new:nnnn {#1} {#2} { \__qam_rank:n {#3} } {#1}
  }

% \qamclaim{key}{frame}{status}   a premise that rests on no input (e.g. a theorem)
\cs_new_protected:Npn \__qam_cmd_claim:nnn #1#2#3
  {
    \__qam_check_frame:n {#2} \__qam_check_status:n {#3}
    \__qam_new:nnnn {#1} {#2} { \__qam_rank:n {#3} } { }
  }

% \qamderive{key}{status}{premise1,premise2,...}
\cs_new_protected:Npn \__qam_cmd_derive:nnn #1#2#3
  {
    \__qam_check_status:n {#2}
    \int_set:Nn \l__qam_min_int { 5 }
    \tl_clear:N \l__qam_weak_tl
    \tl_clear:N \l__qam_frame_tl
    \clist_clear:N \l__qam_inputs_clist
    \clist_map_inline:nn {#3}
      {
        \__qam_if_claim:nT {##1}
          {
            \int_set:Nn \l__qam_rank_int { \prop_item:Nn \g__qam_status_prop {##1} }
            \int_compare:nNnT \l__qam_rank_int < \l__qam_min_int
              { \int_set_eq:NN \l__qam_min_int \l__qam_rank_int \tl_set:Nn \l__qam_weak_tl {##1} }
            \prop_get:NnN \g__qam_inputs_prop {##1} \l__qam_tmp_clist
            \clist_concat:NNN \l__qam_inputs_clist \l__qam_inputs_clist \l__qam_tmp_clist
            \prop_get:NnN \g__qam_frame_prop {##1} \l__qam_tmp_tl
            \tl_if_empty:NTF \l__qam_frame_tl
              { \tl_set_eq:NN \l__qam_frame_tl \l__qam_tmp_tl \tl_set:Nn \l__qam_first_tl {##1} }
              {
                \tl_if_eq:NNF \l__qam_frame_tl \l__qam_tmp_tl
                  {
                    \__qam_problem:nnnnn { frame-mix-combined } {##1} { \tl_use:N \l__qam_tmp_tl }
                      { \tl_use:N \l__qam_first_tl } { \tl_use:N \l__qam_frame_tl }
                  }
              }
          }
      }
    \clist_remove_duplicates:N \l__qam_inputs_clist
    \int_compare:nNnTF \l__qam_min_int = { 5 }
      { \__qam_problem:nnn { no-premises } {#1} { } }
      {
        \int_compare:nNnT { \__qam_rank:n {#2} } > \l__qam_min_int
          {
            \__qam_problem:nnnnn { promotion } {#1} {#2} { \tl_use:N \l__qam_weak_tl }
              { \__qam_name:n { \l__qam_min_int } }
          }
        \__qam_new:nVnV {#1} \l__qam_frame_tl { \__qam_rank:n {#2} } \l__qam_inputs_clist
      }
  }

% \qamconvert{key}{status}{G}{premise}   move a claim into another frame through map G
\cs_new_protected:Npn \__qam_cmd_convert:nnnn #1#2#3#4
  {
    \__qam_check_status:n {#2}
    \prop_if_in:NnF \g__qam_src_prop {#3} { \__qam_problem:nnn { undeclared } {#3} { Map } }
    \__qam_if_claim:nT {#4}
      {
        \prop_get:NnN \g__qam_frame_prop {#4} \l__qam_tmp_tl
        \prop_get:NnNF \g__qam_src_prop {#3} \l__qam_first_tl { \tl_clear:N \l__qam_first_tl }
        \tl_if_eq:NNF \l__qam_first_tl \l__qam_tmp_tl
          { \__qam_problem:nnnnn { map-source } {#3} { \tl_use:N \l__qam_first_tl } {#4} { \tl_use:N \l__qam_tmp_tl } }
        \int_compare:nNnT { \__qam_rank:n {#2} } > { \prop_item:Nn \g__qam_status_prop {#4} }
          {
            \__qam_problem:nnnnn { promotion } {#1} {#2} {#4}
              { \__qam_name:n { \prop_item:Nn \g__qam_status_prop {#4} } }
          }
        \prop_get:NnN \g__qam_inputs_prop {#4} \l__qam_tmp_clist
        \__qam_new:nnnV {#1} { \prop_item:Nn \g__qam_tgt_prop {#3} } { \__qam_rank:n {#2} } \l__qam_tmp_clist
      }
  }

% \qamcompare{a}{b}        a comparison of two claims; requires one frame
\NewDocumentCommand \qamcompare { m m }
  {
    \bool_if:NT \g__qam_export_bool { \__qam_write:x { compare ~ #1 ~ #2 } }
    \__qam_if_claim:nT {#1}
      {
        \__qam_if_claim:nT {#2}
          {
            \str_if_eq:eeF { \prop_item:Nn \g__qam_frame_prop {#1} } { \prop_item:Nn \g__qam_frame_prop {#2} }
              {
                \__qam_problem:nnnnn { frame-mix-compared } {#1} { \prop_item:Nn \g__qam_frame_prop {#1} }
                  {#2} { \prop_item:Nn \g__qam_frame_prop {#2} }
              }
          }
      }
  }

% \qamindependent{key}     assert that a claim rests on no put-in value
\NewDocumentCommand \qamindependent { m }
  {
    \bool_if:NT \g__qam_export_bool { \__qam_write:x { independent ~ #1 } }
    \__qam_if_claim:nT {#1}
      {
        \prop_get:NnN \g__qam_inputs_prop {#1} \l__qam_tmp_clist
        \clist_if_empty:NF \l__qam_tmp_clist
          { \__qam_problem:nnn { not-independent } {#1} { \clist_use:Nn \l__qam_tmp_clist { ,~ } } }
      }
  }

% ---------------------------------------------------------------- typesetting
% \qamstatus{key}  -> status name;  \qamshow{key} -> [status | frame | inputs]
\NewExpandableDocumentCommand \qamstatus { m }
  { \__qam_name:n { \prop_item:Nn \g__qam_status_prop {#1} } }
\NewDocumentCommand \qamshow { m }
  {
    \__qam_if_claim:nT {#1}
      {
        \prop_get:NnN \g__qam_inputs_prop {#1} \l__qam_tmp_clist
        \textsf { \footnotesize
          [ \__qam_name:n { \prop_item:Nn \g__qam_status_prop {#1} } \,\textbar\,
            frame~\prop_item:Nn \g__qam_frame_prop {#1}
            \clist_if_empty:NF \l__qam_tmp_clist { \,\textbar\, inputs:~\clist_use:Nn \l__qam_tmp_clist { ,~ } } ] }
      }
  }

% ---------------------------------------------------------------- user commands with optional symbol
% The optional first argument is the math symbol used in the generated QAM notation,
% e.g. \qaminput[\gamma]{gamma}{M}{computed}.  Default: \mathrm{<key>}.
\cs_new_protected:Npn \__qam_meta:nnnn #1#2#3#4
  {
    \tl_set:Nn \l__qam_kind_tl {#1}
    \tl_if_novalue:nTF {#2} { \tl_set:Nn \l__qam_sym_tl { \mathrm {#3} } } { \tl_set:Nn \l__qam_sym_tl {#2} }
    \tl_set:Nn \l__qam_prem_tl {#4}
    \tl_clear:N \l__qam_stmt_tl
  }
\NewDocumentCommand \qammap { o m m m }
  {
    \tl_if_novalue:nTF {#1} { \prop_gput:Nnn \g__qam_msym_prop {#2} { \mathrm {#2} } }
      { \prop_gput:Nnn \g__qam_msym_prop {#2} {#1} }
    \__qam_cmd_map:nnn {#2} {#3} {#4}
  }
\NewDocumentCommand \qaminput   { o m m m }   { \__qam_meta:nnnn { input }   {#1} {#2} { }  \__qam_cmd_input:nnn {#2} {#3} {#4} }
\NewDocumentCommand \qamclaim   { o m m m }   { \__qam_meta:nnnn { claim }   {#1} {#2} { }  \__qam_cmd_claim:nnn {#2} {#3} {#4} }
% \qamthesis[sym]{key}{frame}{status}{statement}   a starting thesis; its statement is part of its hash
\NewDocumentCommand \qamthesis  { o m m m m }
  {
    \__qam_meta:nnnn { thesis } {#1} {#2} { }
    \tl_if_in:nnT {#5} { ; } { \__qam_problem:nnn { semicolon } {#2} { } }
    \tl_set:Nx \l__qam_stmt_tl { \tl_to_str:n {#5} }
    \__qam_cmd_claim:nnn {#2} {#3} {#4}
  }
\NewDocumentCommand \qamderive  { o m m m }   { \__qam_meta:nnnn { derive }  {#1} {#2} {#4} \__qam_cmd_derive:nnn {#2} {#3} {#4} }
\NewDocumentCommand \qamconvert { o m m m m } { \__qam_meta:nnnn { convert } {#1} {#2} { #4 , #5 } \__qam_cmd_convert:nnnn {#2} {#3} {#4} {#5} }

% ---------------------------------------------------------------- generated QAM notation
% \qam{key}       the claim in QAM notation, with its status tag
% \qam*{key}      the same without status tag
% \qamledger      a table of all claims in declaration order
\cs_new:Npn \__qam_sym:n #1 { \prop_item:Nn \g__qam_sym_prop {#1} }
\cs_new:Npn \__qam_fsym:n #1 { {}^{ \prop_item:Nn \g__qam_frame_prop {#1} } \__qam_sym:n {#1} }
\cs_new_protected:Npn \__qam_witnesses:n #1
  {
    \prop_get:NnN \g__qam_inputs_prop {#1} \l__qam_tmp_clist
    \cs_set:Npn \__qam_wsep: { \cs_set:Npn \__qam_wsep: { , \, } }
    \clist_if_empty:NTF \l__qam_tmp_clist { \emptyset }
      {
        \{ \clist_map_inline:Nn \l__qam_tmp_clist { \__qam_wsep: w \sb { \__qam_sym:n {##1} } } \}
      }
  }
\cs_new_protected:Npn \__qam_form:n #1
  {
    \cs_set:Npn \__qam_wsep: { \cs_set:Npn \__qam_wsep: { , \, } }
    \str_case_e:nn { \prop_item:Nn \g__qam_kind_prop {#1} }
      {
        { input }
          { \__qam_fsym:n {#1} \mathrel{:=} R ( w \sb { \__qam_sym:n {#1} } ) ,\;
            w \sb { \__qam_sym:n {#1} } = \langle 6 , \__qam_sym:n {#1} \rangle }
        { claim }   { \__qam_fsym:n {#1} }
        { thesis }  { \__qam_fsym:n {#1} }
        { derive }
          {
            \__qam_fsym:n {#1} \Leftarrow
            \cs_set:Npn \__qam_psep: { \cs_set:Npn \__qam_psep: { , \, } }
            \clist_map_inline:en { \prop_item:Nn \g__qam_prem_prop {#1} }
              { \__qam_psep: \__qam_fsym:n {##1} }
            \prop_get:NnN \g__qam_inputs_prop {#1} \l__qam_tmp_clist
            \clist_if_empty:NF \l__qam_tmp_clist { ,\; W = \__qam_witnesses:n {#1} }
          }
        { convert } { \__qam_convert_form:ee {#1} { \prop_item:Nn \g__qam_prem_prop {#1} } }
      }
  }
\cs_new_protected:Npn \__qam_convert_form:nn #1#2 { \__qam_convert_form:w {#1} #2 \q_stop }
\cs_generate_variant:Nn \__qam_convert_form:nn { ee }
\cs_new_protected:Npn \__qam_convert_form:w #1#2,#3 \q_stop
  {
    \__qam_fsym:n {#1} = {}^{ \prop_item:Nn \g__qam_frame_prop {#1} }
      {} \sb { \prop_item:Nn \g__qam_src_prop {#2} } \prop_item:Nn \g__qam_msym_prop {#2} \, \__qam_fsym:n {#3}
    \prop_get:NnN \g__qam_inputs_prop {#1} \l__qam_tmp_clist
    \clist_if_empty:NF \l__qam_tmp_clist { ,\; W = \__qam_witnesses:n {#1} }
  }
\cs_generate_variant:Nn \clist_map_inline:nn { en }
\cs_new_protected:Npn \__qam_tag:n #1
  { \; [ \textsf { \__qam_name:n { \prop_item:Nn \g__qam_status_prop {#1} } } ] }
\NewDocumentCommand \qam { s m }
  {
    \__qam_if_claim:nT {#2}
      { \ensuremath { \__qam_form:n {#2} \IfBooleanF {#1} { \__qam_tag:n {#2} } } }
  }
% \qamhash{key}  short hash (8 hex digits);  \qamhash*{key}  full hash;  \qamrecordhash  hash of the whole record
\cs_new:Npn \__qam_short:n #1 { \str_range:nnn {#1} { 1 } { 8 } }
\NewExpandableDocumentCommand \qamhash { s m }
  { \IfBooleanTF {#1} { \prop_item:Nn \g__qam_hash_prop {#2} } { \__qam_short:n { \prop_item:Nn \g__qam_hash_prop {#2} } } }
\cs_new:Npn \__qam_record_hash:
  { \str_mdfive_hash:e { \seq_map_function:NN \g__qam_order_seq \__qam_item_hash:n } }
\cs_new:Npn \__qam_item_hash:n #1 { \prop_item:Nn \g__qam_hash_prop {#1} , }
\NewExpandableDocumentCommand \qamrecordhash { } { \__qam_record_hash: }
\NewDocumentCommand \qamledger { }
  {
    \tl_clear:N \l__qam_tmp_tl
    \seq_map_inline:Nn \g__qam_order_seq
      {
        \tl_put_right:Nn \l__qam_tmp_tl
          { \texttt {##1} & $ \__qam_form:n {##1} $ & \textsf { \__qam_name:n { \prop_item:Nn \g__qam_status_prop {##1} } }
            & \texttt { \footnotesize \__qam_short:n { \prop_item:Nn \g__qam_hash_prop {##1} } } \\ }
      }
    \par\noindent
    \begin{tabular} { @{} l l l l @{} }
      \hline key & QAM~notation & status & hash \\ \hline
      \tl_use:N \l__qam_tmp_tl
      \hline
    \end{tabular}
    \par\noindent
    { \footnotesize record~hash~\texttt { \__qam_record_hash: } \par }
  }

% ---------------------------------------------------------------- export
\bool_new:N \g__qam_open_bool
\seq_new:N  \g__qam_queue_seq
\cs_new_protected:Npn \__qam_write:n #1
  {
    \bool_if:NTF \g__qam_open_bool
      { \iow_now:Nn \g__qam_iow {#1} }
      { \seq_gput_right:Nn \g__qam_queue_seq {#1} }
  }
\cs_generate_variant:Nn \__qam_write:n { x }
% With the option export, every claim is also written as a QAM tuple line to \jobname.qam.
\cs_new_protected:Npn \__qam_export:n #1
  {
    \prop_get:NnN \g__qam_inputs_prop {#1} \l__qam_tmp_clist
    \__qam_write:x
      {
        #1 ~ := ~
        \str_case_e:nn { \tl_use:N \l__qam_kind_tl }
          {
            { input }   { < 6 , #1 > }
            { claim }   { claim }
            { thesis }  { thesis }
            { derive }  { derive ( \tl_use:N \l__qam_prem_tl ) }
            { convert } { convert ( \tl_use:N \l__qam_prem_tl ) }
          }
        ~ ; ~ frame ~ \prop_item:Nn \g__qam_frame_prop {#1}
        ; ~ status ~ \__qam_name:n { \prop_item:Nn \g__qam_status_prop {#1} }
        ; ~ inputs ~ \iow_char:N \{ \clist_use:Nn \l__qam_tmp_clist { , } \iow_char:N \}
        ; ~ hash ~ \prop_item:Nn \g__qam_hash_prop {#1}
        ; ~ sources ~ \iow_char:N \{ \prop_item:Nn \g__qam_srcs_prop {#1} \iow_char:N \}
        \tl_if_empty:NF \l__qam_stmt_tl { ; ~ statement ~ \tl_use:N \l__qam_stmt_tl }
      }
  }
\AtBeginDocument
  {
    \bool_if:NT \g__qam_export_bool
      {
        \iow_open:Nn \g__qam_iow { \c_sys_jobname_str .qam }
        \iow_now:Nx \g__qam_iow { \c_percent_str \c_space_tl QAM~record~exported~by~qam.sty }
        \seq_map_inline:Nn \g__qam_queue_seq { \iow_now:Nn \g__qam_iow {##1} }
        \bool_gset_true:N \g__qam_open_bool
        \file_get_mdfive_hash:nN { \c_sys_jobname_str .tex } \l__qam_tmp_tl
        \iow_now:Nx \g__qam_iow { \c_percent_str \c_space_tl source ~ \c_sys_jobname_str .tex ~ md5 ~ \l__qam_tmp_tl }
      }
  }

\AtEndDocument
  {
    \bool_if:NT \g__qam_export_bool
      { \iow_now:Nx \g__qam_iow { \c_percent_str \c_space_tl record ~ \__qam_record_hash: } }
  }
