vars=Array[x,4]; triples=Select[Tuples[Range[4],3],OrderedQ]; exponents=Table[Count[t,i],{t,triples},{i,4}]; units=IdentityMatrix[4]; pairs=Subsets[Range[4],{2}]; dirs=Join[units,Flatten[Table[{units[[p[[1]]]]+units[[p[[2]]]],units[[p[[1]]]]-units[[p[[2]]]]},{p,pairs}],1],Table[Total[units[[t]]],{t,Subsets[Range[4],{3}]}]]; mon=Table[Times@@(vars^a),{a,exponents}]; M=Table[mon/.Thread[vars->d],{d,dirs}]; inv=Inverse[M]; c=Array[a,20]; reconstruction=Simplify[inv.(M.c)-c]; ExportString[<|"directions"->dirs,"triples"->triples,"determinant"->Det[M],"rank"->MatrixRank[M],"inverse"->inv,"symbolicReconstructionZero"->(reconstruction===ConstantArray[0,20]),"convention"->"P(d)=D^3 R[d,d,d]/6; normalized cubic Taylor coefficients c=Inverse[M].P(d)"|>,"RawJSON"]
